with "protobuf_runtime.gpr";

with "protobuf_config.gpr";

project Compiler_Options_Test is
   for Source_Dirs use ("../source/compiler", "../source/compiler_tests");
   for Source_Files use
     ("compiler.ads",
      "compiler-options.ads",
      "compiler-options.adb",
      "compiler_options_test.adb");

   for Exec_Dir   use "../.objs/compiler_tests";
   for Object_Dir use "../.objs/compiler_tests/obj";
   for Main use ("compiler_options_test.adb");
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use
        Protobuf_Config.Ada_Compiler_Switches & ("-gnatW8", "-g");
   end Compiler;
end Compiler_Options_Test;
