with "protobuf_runtime.gpr";

with "protobuf_config.gpr";

project Compiler_Tests is
   for Source_Dirs use
     ("../source/compiler",
      "../source/compiler/generated",
      "../source/compiler_tests");

   for Exec_Dir   use "../.objs/compiler_tests";
   for Object_Dir use "../.objs/compiler_tests/obj";
   for Main use ("compiler_options_test.adb", "compiler_bounds_test.adb");
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use
        Protobuf_Config.Ada_Compiler_Switches & ("-gnatW8", "-g");
   end Compiler;
end Compiler_Tests;
