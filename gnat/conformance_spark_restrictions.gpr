--  Compiles the code that conformance_spark.sh generates, and the runtime,
--  under the restrictions of light runtimes. The testee itself does not
--  follow them, so it is built by conformance_spark.gpr, apart from this.
--  Use with gprbuild -c: nothing here is linked.

project Conformance_SPARK_Restrictions is
   for Source_Dirs use
     ("../source/spark_runtime",
      "../source/conformance_spark",
      "../.objs/conformance_spark/generated");
   for Excluded_Source_Files use ("conformance-spark_run.adb");
   for Object_Dir use "../.objs/conformance_spark/restricted";
   for Languages use ("Ada");
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use ("-gnatW8", "-gnatwe");
      for Local_Configuration_Pragmas use
        "../source/spark_runtime/restrictions.adc";
   end Compiler;
end Conformance_SPARK_Restrictions;
