--  Conformance testee for SPARK generated code. conformance_spark.sh
--  generates the code into .objs/conformance_spark/generated first. The
--  runtime is built from source, with all checks and assertions on.

project Conformance_SPARK is
   for Source_Dirs use
     ("../source/spark_runtime",
      "../source/conformance_spark",
      "../.objs/conformance_spark/generated");
   for Object_Dir use "../.objs/conformance_spark/obj";
   for Exec_Dir use "../.objs/conformance_spark";
   for Main use ("conformance-spark_run.adb");
   for Languages use ("Ada");
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use ("-gnatW8", "-g", "-gnata", "-gnatVa");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-E");
   end Binder;
end Conformance_SPARK;
