--  Types shared by SPARK code generated by protoc-gen-ada. This runtime uses
--  no heap, exceptions, secondary stack or finalization, so it works on light
--  and bare-metal Ada runtimes.

with Interfaces;

package PB_SPARK with SPARK_Mode, Pure is

   Max_Buffer_Size : constant := 2 ** 30;
   --  The largest buffer that can be encoded to or decoded from

   type Index is range 0 .. Max_Buffer_Size + 1;
   --  A position in a buffer, or just before or after it. This type doesn't
   --  depend on the size of Integer, which is 16 bits on small targets.

   subtype Position is Index range 1 .. Index'Last;

   subtype Buffer_Last is Index range 0 .. Max_Buffer_Size;
   --  The last position used by a buffer. An empty buffer has 0 here.

   subtype Byte is Interfaces.Unsigned_8;

   type Byte_Array is array (Position range <>) of Byte;

   type Status_Kind is
     (OK,
      Truncated,         --  Input ended in the middle of a value
      Malformed,         --  Input is not valid protobuf
      Limit_Exceeded,    --  Input doesn't fit declared bounds
      Invalid_UTF8,      --  A string field is not valid UTF-8
      Missing_Required,  --  A proto2 required field was not present
      Unknown_Enum);     --  An enum value this schema doesn't define

   function Valid_Buffer (Buffer : Byte_Array) return Boolean is
     (Buffer'First = 1 and then Buffer'Last in Buffer_Last);
   --  All buffers start at 1

end PB_SPARK;
